{
  "name": "@local/dsh-session-cleaner-host",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "DeepSeek Harness plugin: delete a whole conversation, and quote/ask a text selection from the right-click context menu (Copy / Quote / Ask) through a reused concurrent subagent (host + Web client in one bundle).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "subagent",
    "compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingleboat/dsh-session-cleaner-host.git"
  },
  "scripts": {
    "test": "node test/internals.test.mjs && node test/client-context-menu.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
